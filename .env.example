# =============================================================================
# Frontend Build-Time Variables (safe to expose in browser via Vite)
# =============================================================================
# Supabase Project Configuration (Read-Only / RLS-Protected Client Access)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Deployed Backend Base URL for the AI FloodGuard Assistant on GitHub Pages
# Example: https://nyc-floodguard-api.onrender.com
# Leave blank for local full-stack development (defaults to same-origin /api/assistant).
VITE_ASSISTANT_API_URL=

# =============================================================================
# Backend Server-Only Variables (NEVER expose to browser or commit secrets)
# =============================================================================
# Gemini API Key (set securely in Render / server environment variables)
GEMINI_API_KEY=

# Comma-separated list of allowed frontend origins for CORS
# Example: https://kdawtech.github.io
ALLOWED_ORIGINS=https://kdawtech.github.io

# Basic per-IP rate limiting for POST /api/assistant
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=15
